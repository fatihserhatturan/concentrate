# Folder that holds the projects to scan (mounted read-write at /workspace; graphs go to <project>/.concentrate/graph)
WORKSPACE=/Users/you/projects
# Fixed access token (16+ chars of A-Z a-z 0-9 _ -); generate one with: openssl rand -hex 24
CONCENTRATE_TOKEN=change-me-to-a-long-random-string
# Host port (optional)
PORT=4173
