{
  "$comment": "C and C++ agent benchmark questions over the pinned cJSON, tinyxml2, googletest, Crow, Drogon, cpp-httplib, gRPC C++ and Qt SQL samples: routes, callers, change impact, header \u2192 definition, build targets, env reads and data access. Expected answers were written by reading the pinned source (the registration macros and calls, the call sites of cJSON_New_Item and ParseDb, the tinyxml2 and cJSON declarations, the CMakeLists of Crow and gRPC, the GetEnv calls of gtest.cc, the Qt table setup), not from Concentrate output. Scoring as in questions.json.",
  "questions": [
    {
      "id": "cpp-crow-chat-routes",
      "sample": "internet-cpp-crow-examples",
      "category": "routes",
      "question": "In the Crow examples, which route paths does examples/example_chat.cpp register besides the index page?",
      "expected": {
        "mustInclude": [
          "/logs",
          "/logs/<int>",
          "/send"
        ]
      }
    },
    {
      "id": "cpp-drogon-hello-routes",
      "sample": "internet-cpp-drogon-examples",
      "category": "routes",
      "question": "Which URL paths does examples/helloworld/main.cc register with app().registerHandler?",
      "expected": {
        "mustInclude": [
          "/user/{user-name}",
          "/hello_user",
          "/hello?user={user-name}"
        ]
      }
    },
    {
      "id": "cpp-httplib-server-routes",
      "sample": "internet-cpp-httplib-examples",
      "category": "routes",
      "question": "Which route paths does example/server.cc register on its httplib::Server?",
      "expected": {
        "mustInclude": [
          "/hi",
          "/slow",
          "/dump",
          "/stop"
        ]
      }
    },
    {
      "id": "cpp-cjson-new-item-callers",
      "sample": "internet-c-cjson",
      "category": "callers",
      "question": "Which functions in cJSON.c call the static function cJSON_New_Item? List the function names.",
