{
  // Base settings; appsettings.<Environment>.json overrides them.
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "ConnectionStrings": {
    "Orders": "Server=db.local;Database=orders;User Id=app;Password=hunter2;"
  },
  "Jwt": {
    "Issuer": "https://auth.example.com",
    "Audience": "orders-api",
    "SigningKey": "super-secret-signing-key",
    "ExpiryMinutes": 30
  },
  "Mail": {
    "Host": "smtp.example.com",
    "Port": 587,
    "UseSsl": true,
    "Recipients": [ "ops@example.com", "billing@example.com" ]
  },
  "Storage": {
    "Container": "invoices",
    "MaxBytes": 1048576
  },
  "Features": {
    "Banner": "Welcome",
    "Cache": { "Ttl": { "Seconds": 60 } }
  },
  "Limits": { "MaxItems": 100 },
  "Status": { "Banner": "All systems go" },
}
