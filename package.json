{
  "name": "concentrate",
  "version": "0.1.0",
  "description": "Turns a codebase into a queryable code graph (routes, calls, DI, env, data access) and serves it to AI agents over MCP.",
  "keywords": [
    "code-graph",
    "static-analysis",
    "mcp",
    "model-context-protocol",
    "tree-sitter",
    "cypher",
    "code-intelligence",
    "ai-agents",
    "llm",
    "typescript",
    "nestjs",
    "express",
    "fastify"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatihserhatturan/concentrate.git"
  },
  "homepage": "https://github.com/fatihserhatturan/concentrate#readme",
  "bugs": {
    "url": "https://github.com/fatihserhatturan/concentrate/issues"
  },
  "private": true,
  "type": "module",
  "bin": {
    "concentrate": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "scan": "tsx src/index.ts scan",
    "smoke:samples": "tsx src/index.ts smoke",
    "bench:store": "tsx scripts/bench-store.ts",
    "bench:parser": "npm run build && tsx scripts/bench-parser.ts --dist",
    "bench:accuracy": "tsx scripts/bench-accuracy.ts",
    "bench:release": "npm run build && tsx scripts/bench-release.ts",
    "probe:memory": "node --expose-gc --import tsx scripts/scan-memory-probe.ts",
    "bench:agent": "npm run build && tsx scripts/bench-agent.ts",
    "benchmark:incremental": "npm run smoke:samples -- --suite all --incremental-benchmark --report .concentrate/incremental-benchmark-report.json --semantic-samples 5",
    "stats": "tsx src/index.ts stats",
    "query": "tsx src/index.ts query",
    "mcp": "tsx src/index.ts mcp",
    "verify:rc": "npm run typecheck && npm test && npm run build && npm run smoke:samples -- --suite standing --report .concentrate/smoke-standing-rc-report.json --semantic-samples 5",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "golden:update": "UPDATE_GOLDEN=1 tsx --test tests/golden*.test.ts",
    "samples:fetch": "node scripts/fetch-samples.mjs",
    "grammars:build": "node scripts/build-grammars.mjs",
    "test:samples": "REQUIRE_SAMPLES=1 tsx --test tests/golden-samples.test.ts tests/golden-queries.test.ts"
  },
  "files": [
    "dist",
    "vendor/grammars"
  ],
  "dependencies": {
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tree-sitter-cli": "0.27.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
